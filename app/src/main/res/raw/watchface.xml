<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <BitmapFonts>
        <BitmapFont name="nixie_digits">
            <Character name="0" resource="digit_0" width="74" height="180"/>
            <Character name="1" resource="digit_1" width="74" height="180"/>
            <Character name="2" resource="digit_2" width="74" height="180"/>
            <Character name="3" resource="digit_3" width="74" height="180"/>
            <Character name="4" resource="digit_4" width="74" height="180"/>
            <Character name="5" resource="digit_5" width="74" height="180"/>
            <Character name="6" resource="digit_6" width="74" height="180"/>
            <Character name="7" resource="digit_7" width="74" height="180"/>
            <Character name="8" resource="digit_8" width="74" height="180"/>
            <Character name="9" resource="digit_9" width="74" height="180"/>
        </BitmapFont>
    </BitmapFonts>
    <Scene>
        <Background>
            <Color value="#000000"/>
        </Background>
        <PartImage x="0" y="0" width="450" height="450">
            <Image resource="nixie_background"/>
        </PartImage>

        <!-- One two-digit clock per vertical tube: hours, minutes, seconds. -->
        <DigitalClock x="25" y="143" width="150" height="164">
            <TimeText x="0" y="0" width="150" height="164" format="hh"
                align="CENTER" verticalAlign="CENTER">
                <BitmapFont family="nixie_digits" size="88" color="#FFFFFF"/>
                <Variant mode="AMBIENT">
                    <BitmapFont family="nixie_digits" size="84" color="#777777"/>
                </Variant>
            </TimeText>
        </DigitalClock>
        <DigitalClock x="150" y="143" width="150" height="164">
            <TimeText x="0" y="0" width="150" height="164" format="mm"
                align="CENTER" verticalAlign="CENTER">
                <BitmapFont family="nixie_digits" size="88" color="#FFFFFF"/>
                <Variant mode="AMBIENT">
                    <BitmapFont family="nixie_digits" size="84" color="#777777"/>
                </Variant>
            </TimeText>
        </DigitalClock>
        <DigitalClock x="275" y="143" width="150" height="164">
            <TimeText x="0" y="0" width="150" height="164" format="ss"
                align="CENTER" verticalAlign="CENTER">
                <BitmapFont family="nixie_digits" size="88" color="#FFFFFF"/>
                <Variant mode="AMBIENT">
                    <BitmapFont family="nixie_digits" size="84" color="#777777"/>
                </Variant>
            </TimeText>
        </DigitalClock>

        <PartAnimatedImage x="0" y="0" width="450" height="450">
            <AnimationController play="ON_NEXT_SECOND" repeat="FALSE"
                beforePlaying="DO_NOTHING" afterPlaying="DO_NOTHING"/>
            <AnimatedImage resource="flicker" format="AGIF"/>
            <Thumbnail resource="nixie_background"/>
        </PartAnimatedImage>
    </Scene>
</WatchFace>